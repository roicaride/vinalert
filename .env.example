# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/vinalert

# JWT signing key. Generate one with: openssl rand -hex 32
SECRET_KEY=generate_a_secure_key_with_openssl_rand_hex_32

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hours between scheduled weather refreshes.
CLIMA_INTERVALO_HORAS=3

# Weather provider key. See app/services/weather.py for the registry.
WEATHER_PROVIDER=open-meteo

# Seed users created by semilla_inicial.py. The defaults are development-only
# and published in this repository — override them before seeding any database
# that is reachable from outside your machine.
SEMILLA_ADMIN_EMAIL=admin@vinalert.dev
SEMILLA_ADMIN_PASSWORD=change_me
SEMILLA_AGRICULTOR_EMAIL=agricultor@vinalert.dev
SEMILLA_AGRICULTOR_PASSWORD=change_me
